# .env.example de Shift Bank (Etapa 3, Tarea 27) — PLANTILLA SIN SECRETOS.
#
# Decisión D-E3-04 / Diseño §4.3 (R12.1): el backend recibe sus claves por entorno. Este archivo
# documenta los NOMBRES de las 4 variables requeridas con valores de marcador de posición
# (vacíos). Cópialo a `.env` (NO versionado; git-ignorado) y rellena valores REALES antes de
# `docker compose up`. NUNCA pongas secretos reales en este archivo ni lo versiones con valores.
#
# Fail-closed (R12.2): si una variable falta o es inválida, el backend aborta el arranque en su
# `lifespan`; el healthcheck nunca pasa y Compose marca el servicio como no saludable. El
# material de clave jamás se registra en logs/errores.
#
# -----------------------------------------------------------------------------------------------
# SHIFT_ENC_KEYS — mapa de claves de cifrado AES-256-GCM, formato "kid:base64" separado por comas.
#   Cada clave debe decodificar base64 a EXACTAMENTE 32 bytes (256 bits). Puedes definir varias
#   entradas (rotación) separándolas por comas: "kid1:...,kid2:...".
#   Generar una clave de 32 bytes en base64 (elige un `kid` corto, p. ej. k1):
#     Linux/macOS:  printf 'k1:'; openssl rand -base64 32
#     Windows PS :  'k1:' + [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}))
#   Ejemplo de FORMATO (NO usar este valor): k1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SHIFT_ENC_KEYS=

# SHIFT_ENC_ACTIVE_KID — el `kid` activo con el que se CIFRA (debe existir en SHIFT_ENC_KEYS).
#   Ejemplo de FORMATO (NO usar): k1
SHIFT_ENC_ACTIVE_KID=

# SHIFT_AUDIT_HMAC_KEY — clave secreta para la cadena HMAC-SHA256 de auditoría (no vacía).
#   Usa material aleatorio de alta entropía (p. ej. 32 bytes en base64).
#     Linux/macOS:  openssl rand -base64 32
#     Windows PS :  [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}))
SHIFT_AUDIT_HMAC_KEY=

# SHIFT_ADMIN_TOKEN — token para la verificación administrativa de la cadena de auditoría
#   (endpoint protegido). Cadena secreta no vacía; trátala como credencial.
SHIFT_ADMIN_TOKEN=
