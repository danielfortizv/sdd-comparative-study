# Shift Bank Local Containerized Deployment Secrets
# MANDATORY: Generate strong, unique secret keys before starting containers.
# Startup will fail if any of these secrets are missing or empty.

# 32-byte key for AES-256-GCM encryption at rest (generate e.g. with: openssl rand -hex 32 or python -c "import secrets; print(secrets.token_hex(32))")
ENCRYPTION_KEY=

# HMAC-SHA256 signing key for append-only audit ledger (at least 16 bytes, e.g. openssl rand -base64 32)
AUDIT_SECRET_KEY=

# Administrative secret protecting GET /api/audit/verify and migration endpoints (e.g. openssl rand -hex 24)
ADMIN_SECRET_KEY=

# Persistent volume database path
DATABASE_URL=sqlite:////app/data/shift_bank.db
