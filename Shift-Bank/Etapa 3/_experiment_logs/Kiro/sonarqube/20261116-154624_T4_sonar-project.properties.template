# =============================================================================
# Plantilla de configuración del escáner SonarQube — Shift Bank Etapa 3 (Kiro)
# Registrada en la Tarea 4 (preflight) para REUSO por:
#   - T32: PRE-scan de la Etapa 3 (antes de la fase correctiva)
#   - T35: escaneo final (idéntico alcance/cobertura, comparable 1:1 con el PRE)
#
# ESTE ARCHIVO NO DISPARA NINGÚN ESCANEO. Es sólo la configuración exacta que
# los escaneos posteriores reutilizarán. El investigador ejecuta SonarQube.
#
# Para usarlo en T32/T35: copiar al raíz del proyecto escaneado (p. ej. a
# `Etapa 3/Kiro/sonar-project.properties`) junto a los reportes de cobertura ya
# generados, y lanzar el scanner apuntando a la instancia del investigador.
# Fecha/hora (local): 2026-11-16 15:46:24
# =============================================================================

# --- Identidad del proyecto (misma clave en PRE y final para comparar 1:1) ---
sonar.projectKey=shift-bank-stage3-kiro
sonar.projectName=Shift Bank Etapa 3 (Kiro)
sonar.projectVersion=3.0

# --- Alcance de código fuente (backend Python + frontend TS/React) ---
# Rutas relativas al raíz del proyecto `Etapa 3/Kiro/`.
sonar.sources=backend/app,frontend/src

# --- Rutas de pruebas ---
sonar.tests=backend/tests,frontend/src
sonar.test.inclusions=backend/tests/**/*.py,frontend/src/**/*.test.ts,frontend/src/**/*.test.tsx,frontend/src/**/*.spec.ts,frontend/src/**/*.spec.tsx

# --- Codificación / lenguaje ---
sonar.sourceEncoding=UTF-8

# --- Cobertura backend (Cobertura XML producido por pytest-cov / coverage.py) ---
# Generar ANTES del escaneo con (desde backend/, venv activa):
#   python -m pytest --cov=app --cov-report=xml:coverage.xml
# Ruta relativa al raíz del proyecto escaneado:
sonar.python.coverage.reportPaths=backend/coverage.xml
sonar.python.version=3.13

# --- Cobertura frontend (LCOV producido por Vitest, disponible tras la T30) ---
# Generar ANTES del escaneo con (desde frontend/):
#   vitest run --coverage      # produce frontend/coverage/lcov.info
# Si en el momento del PRE-scan aún no hay pruebas de frontend (Vitest se añade
# en la T30), esta ruta puede no existir todavía; el final (T35) debe incluirla.
sonar.javascript.lcov.reportPaths=frontend/coverage/lcov.info

# --- Exclusiones (no son código de producción a evaluar ni deben contar en cobertura) ---
sonar.exclusions=\
  **/node_modules/**,\
  **/dist/**,\
  **/.venv/**,\
  **/__pycache__/**,\
  **/*.db,\
  frontend/vite.config.ts,\
  backend/app/seed.py

# Excluir las propias pruebas del cálculo de cobertura (se miden como tests, no como fuente cubierta)
sonar.coverage.exclusions=\
  backend/tests/**,\
  frontend/src/**/*.test.*,\
  frontend/src/**/*.spec.*

# --- Duplicación: no penalizar duplicados dentro de las pruebas ---
sonar.cpd.exclusions=backend/tests/**,frontend/src/**/*.test.*,frontend/src/**/*.spec.*
