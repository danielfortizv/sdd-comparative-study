{
  "name": "ecommerce-stage1-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Demonstration e-commerce Stage 1 frontend (React + TypeScript).",
  "scripts": {
    "dev": "vite",
