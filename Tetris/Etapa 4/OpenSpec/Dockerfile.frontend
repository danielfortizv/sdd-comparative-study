# Stage 1: Build production assets using LTS Node 24 (RUNTIME-POLICY-01)
FROM node:24-slim AS builder

WORKDIR /build

# Copy manifest files
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies using committed lock
RUN npm ci

# Copy other source code
COPY frontend/ .

# Run build
RUN npm run build

# Stage 2: Nginx production runner using official stable Nginx Alpine image (RUNTIME-POLICY-01)
FROM nginx:stable-alpine AS runner

# Install curl for healthcheck
RUN apk add --no-cache curl

WORKDIR /usr/share/nginx/html

# Copy built assets
COPY --from=builder /build/dist .

# Copy custom non-root nginx configuration
COPY frontend/nginx.conf /etc/nginx/nginx.conf

# Set permissions for files to ensure they are readable by nginx user
RUN touch /tmp/nginx.pid && \
    chown -R nginx:nginx /usr/share/nginx/html /etc/nginx /tmp

# Switch to standard non-root nginx user
USER nginx

# Expose production port
EXPOSE 5514

# Healthcheck
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5514/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
